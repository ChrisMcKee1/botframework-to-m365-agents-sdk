{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "11111111-aaaa-2222-bbbb-333333333333",
  "developer": {
    "name": "Migration Demo",
    "websiteUrl": "https://learn.microsoft.com/microsoftteams/platform/",
    "privacyUrl": "https://learn.microsoft.com/legal/microsoft-365/privacy",
    "termsOfUseUrl": "https://learn.microsoft.com/legal/microsoft-365/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Agents Migration Demo",
    "full": "Bot Framework v4 to Microsoft 365 Agents SDK Migration Demo"
  },
  "description": {
    "short": "Reference bot used to demonstrate the v4 to Agents SDK migration.",
    "full": "Greets you, asks for your name, and confirms it back. The same bot registration is reused by both the before (Bot Framework SDK v4) and after (Microsoft 365 Agents SDK) samples to make the migration diff observable in Teams."
  },
  "accentColor": "#0078D4",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["*.devtunnels.ms"],
  "copilotAgents": {
    "customEngineAgents": [
      {
        "type": "bot",
        "id": "00000000-0000-0000-0000-000000000000"
      }
    ]
  }
}
